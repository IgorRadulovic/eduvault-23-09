# ─────────────────────────────────────────────────────────────────────────────
# EduVault — Environment Variables
#
# FOR LOCAL DEV:  Copy this file to .env.local and fill in your values.
# FOR VERCEL:     Add each variable under Project → Settings → Environment Variables.
# NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://your-domain.com

# ── Firebase Auth ─────────────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from: Supabase → Project → Settings → API
# Use the ANON/PUBLIC key — never the service_role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Stripe (add when ready) ───────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=
